{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build addon",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "src/WeekendCollections/WeekendCollections.csproj",
        "-c",
        "Release",
        "-p:SptRoot=${input:sptRoot}"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Validate collections",
      "type": "process",
      "command": "python",
      "args": [
        "tools/validate.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "Package release",
      "type": "process",
      "command": "python",
      "args": [
        "tools/package.py"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "sptRoot",
      "type": "promptString",
      "description": "Path to SPT_Runtime"
    }
  ]
}
